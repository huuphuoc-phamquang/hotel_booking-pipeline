// CI/CD cho 2 FastAPI (booking-mcp, drift-api) + agent kagent. Script path của job: edai2/ci/Jenkinsfile; Jenkins
// checkout cả repo nên mọi bước chạy trong dir('edai2').
// Rubric edai-2 › CI/CD:
//   - "all secrets should be saved in Jenkins or similar tools": secret lấy từ Vault qua plugin HashiCorp Vault
//   - CI/CD cho MCP Servers & Agents: build & deploy MCP server trước -> deploy agent dùng MCP đó
//   - Agent dùng System Prompt từ Langfuse: stage "Fetch prompt" lấy prompt label production
// booking-mcp, drift-api cùng chart helm/api, --atomic tự rollback.
// Rubric edai-2 › Validation: stage Test chạy coverage >= 90 và mutmut chỉ trên file thay đổi.
// WITH_DRIFT_API / WITH_AGENTS (mặc định false): bật khi cluster đã có model alias production trên MLflow, Langfuse,
// kagent; tắt thì chỉ test + build + deploy booking-mcp.
pipeline {
  agent { kubernetes { yamlFile 'edai2/ci/pod-template.yaml'; defaultContainer 'tools' } }
  parameters {
    booleanParam(name: 'WITH_DRIFT_API', defaultValue: false, description: 'build + deploy drift-api (cần alias production trên MLflow)')
    booleanParam(name: 'WITH_AGENTS', defaultValue: false, description: 'deploy agent kagent (cần Langfuse + kagent)')
  }
  environment {
    REGISTRY = "asia-southeast1-docker.pkg.dev/${env.GCP_PROJECT}/booking"   // Artifact Registry (iac/modules/registry)
    TAG      = "${env.GIT_COMMIT.take(7)}"
  }
  stages {
    stage('Test') {
      steps {
        dir('edai2') {
          sh 'pip install -r requirements-dev.txt'
          sh 'PYTHONPATH="mcp_server:dags:observability" pytest tests/ --ignore=tests/test_drift_api.py --cov=mcp_server --cov=observability --cov-fail-under=90 --junitxml=report.xml -o asyncio_mode=auto'
          sh 'pip install -r drift_api/requirements.txt && PYTHONPATH=drift_api pytest tests/test_drift_api.py --cov=drift_api --cov-fail-under=90'
          sh '''
            # so với commit build thành công gần nhất (lần đầu: commit trước); git lỗi thì dừng, không âm thầm bỏ mutmut
            BASE=${GIT_PREVIOUS_SUCCESSFUL_COMMIT:-HEAD~1}
            FILES=$(git diff --relative --name-only "$BASE" HEAD -- 'mcp_server/*.py')
            CHANGED=$(echo "$FILES" | paste -sd, -)
            echo "mcp_server thay đổi từ $BASE: ${CHANGED:-không có}"
            if [ -n "$CHANGED" ]; then
              mutmut run --paths-to-mutate "$CHANGED"   # mutmut 2.x (pin <3; bản 3 bỏ cờ này)
              python ci/check_mutation_score.py --min 0.8
            fi
          '''
        }
      }
      post { always { junit 'edai2/report.xml' } }
    }
    stage('Reference cho drift-api') {
      when { expression { params.WITH_DRIFT_API } }
      steps {
        dir('edai2') {
          withVault([vaultSecrets: [[path: 'secret/ci/mlflow', secretValues: [[envVar: 'MLFLOW_TRACKING_URI', vaultKey: 'uri']]]]]) {
            // artifact reference_lead_days.npy của run đã đăng ký alias production (evaluate_and_register)
            sh '''python -c "
import mlflow; from mlflow.tracking import MlflowClient
mv = MlflowClient().get_model_version_by_alias('cancel-risk', 'production')
mlflow.artifacts.download_artifacts(run_id=mv.run_id, artifact_path='reference_lead_days.npy', dst_path='drift_api/reference')
open('drift_api/reference/MODEL_VERSION', 'w').write(mv.version)"'''
          }
        }
      }
    }
    stage('Build & push images') {
      environment { APPS = "mcp_server:agents/booking-mcp${params.WITH_DRIFT_API ? ' drift_api:ml/drift-api' : ''}" }
      steps {
        dir('edai2') {
          withVault([vaultSecrets: [[path: 'secret/ci/registry', secretValues: [[envVar: 'REG_KEY', vaultKey: 'json_key']]]]]) {
            // khoá lưu base64 một dòng (plugin Vault chỉ che được secret một dòng); set +x để trace không in lệnh
            sh '''
              set +x
              printenv REG_KEY | docker login -u _json_key_base64 --password-stdin https://asia-southeast1-docker.pkg.dev
            '''
            sh '''
              for app in $APPS; do
                docker build -f docker/api.Dockerfile --build-arg APP=${app%%:*} -t $REGISTRY/${app#*:}:$TAG .
                docker push $REGISTRY/${app#*:}:$TAG
              done
            '''
          }
        }
      }
    }
    stage('Deploy APIs') {
      steps {
        dir('edai2') {
          // --atomic: pod mới không Ready trong 5 phút thì tự rollback
          sh '''
            deploy() { helm upgrade --install $1 helm/api -n $2 -f helm/api/values-$1.yaml \
                         --set image.repository=$REGISTRY/$3 --set image.tag=$TAG --set replicaCount=${API_REPLICAS:-2} $4 \
                         --atomic --timeout 5m; }   # API_REPLICAS: biến toàn cục của Jenkins (JCasC), quota thấp thì 1
            if [ "$WITH_DRIFT_API" = true ]; then
              deploy drift-api ml ml/drift-api "--set env.MODEL_VERSION=$(cat drift_api/reference/MODEL_VERSION)"
            fi
            deploy booking-mcp agents agents/booking-mcp
          '''
        }
      }
    }
    stage('Fetch prompt') {
      when { expression { params.WITH_AGENTS } }
      steps {
        dir('edai2') {
          withVault([vaultSecrets: [[path: 'secret/ci/langfuse', secretValues: [
              [envVar: 'LANGFUSE_PUBLIC_KEY', vaultKey: 'public_key'],
              [envVar: 'LANGFUSE_SECRET_KEY', vaultKey: 'secret_key'],
              [envVar: 'LANGFUSE_HOST', vaultKey: 'host']]]]]) {
            sh 'python ci/render_agents.py --prompt-label production --out build/agents.yaml'
          }
        }
      }
    }
    stage('Deploy agents') {
      when { expression { params.WITH_AGENTS } }
      steps {
        dir('edai2') {
          sh 'kubectl apply -f build/agents.yaml'
          // agentregistry v0.4.0 (k8s/agentregistry-values.yaml); card lấy từ kagent controller trong cluster
          sh '''
            POLICY=predict_cancellation,search_policy,propose_overbooking,apply_overbooking
            for spec in data-agent:get_booking_features:qwen-3b policy-agent:$POLICY:qwen-3b \
                        policy-agent-v2:$POLICY:qwen-booking-v2 coordinator-agent::qwen-3b; do
              a=${spec%%:*}; rest=${spec#*:}; tools=${rest%%:*}; model=${rest#*:}
              kubectl -n kagent rollout status deploy/$a --timeout=180s
              python ci/publish_agent_card.py --agent $a --tools "$tools" --model $model --tag $TAG \
                --registry http://agentregistry.agentregistry.svc.cluster.local:12121
            done
          '''
        }
      }
    }
  }
}
