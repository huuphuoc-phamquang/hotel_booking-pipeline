{
 "uid": "booking-apis",
 "title": "Booking APIs (booking-mcp, drift-api)",
 "schemaVersion": 39,
 "time": {
  "from": "now-6h",
  "to": "now"
 },
 "refresh": "30s",
 "tags": [
  "booking"
 ],
 "panels": [
  {
   "id": 1,
   "type": "timeseries",
   "title": "Request / giây theo service",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 0,
    "y": 0,
    "w": 12,
    "h": 8
   },
   "fieldConfig": {
    "defaults": {
     "unit": "reqps"
    },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum by (service, handler) (rate(http_requests_total{handler!~\"/metrics|/healthz|/readyz\"}[1m]))",
     "legendFormat": "{{service}} {{handler}}"
    }
   ]
  },
  {
   "id": 2,
   "type": "timeseries",
   "title": "Tỉ lệ lỗi 5xx",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 12,
    "y": 0,
    "w": 12,
    "h": 8
   },
   "fieldConfig": {
    "defaults": {
     "unit": "percentunit"
    },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum by (service) (rate(http_requests_total{status=\"5xx\"}[5m])) / sum by (service) (rate(http_requests_total[5m]))",
     "legendFormat": "{{service}}"
    }
   ]
  },
  {
   "id": 3,
   "type": "timeseries",
   "title": "Latency p95",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 0,
    "y": 8,
    "w": 12,
    "h": 8
   },
   "fieldConfig": {
    "defaults": {
     "unit": "s"
    },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "expr": "histogram_quantile(0.95, sum by (le, service) (rate(http_request_duration_seconds_bucket[5m])))",
     "legendFormat": "{{service}} p95"
    }
   ]
  },
  {
   "id": 4,
   "type": "timeseries",
   "title": "Tổng số request",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 12,
    "y": 8,
    "w": 12,
    "h": 8
   },
   "fieldConfig": {
    "defaults": {
     "unit": "short"
    },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum by (service) (increase(http_requests_total[1h]))",
     "legendFormat": "{{service}}"
    }
   ]
  },
  {
   "id": 5,
   "type": "timeseries",
   "title": "MCP tool: số lần gọi / lỗi",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 0,
    "y": 16,
    "w": 12,
    "h": 8
   },
   "fieldConfig": {
    "defaults": {
     "unit": "ops"
    },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum by (tool) (rate(mcp_tool_calls_total[5m]))",
     "legendFormat": "calls {{tool}}"
    },
    {
     "refId": "B",
     "expr": "sum by (tool) (rate(mcp_tool_failures_total[5m]))",
     "legendFormat": "fail {{tool}}"
    }
   ]
  },
  {
   "id": 6,
   "type": "timeseries",
   "title": "Replica (KEDA)",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 12,
    "y": 16,
    "w": 12,
    "h": 8
   },
   "fieldConfig": {
    "defaults": {
     "unit": "short"
    },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum by (deployment) (kube_deployment_status_replicas{deployment=~\"drift-api|booking-mcp|.*-agent.*\"})",
     "legendFormat": "{{deployment}}"
    }
   ]
  }
 ]
}
