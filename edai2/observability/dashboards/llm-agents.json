{
 "uid": "llm-agents",
 "title": "LLM + agent",
 "schemaVersion": 39,
 "time": {
  "from": "now-6h",
  "to": "now"
 },
 "refresh": "30s",
 "tags": [
  "booking"
 ],
 "panels": [
  {
   "id": 1,
   "type": "timeseries",
   "title": "Token / giây theo model",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 0,
    "y": 0,
    "w": 12,
    "h": 8
   },
   "fieldConfig": {
    "defaults": {
     "unit": "short"
    },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum by (model, kind) (rate(llm_tokens_total[5m]))",
     "legendFormat": "{{model}} {{kind}}"
    }
   ]
  },
  {
   "id": 2,
   "type": "timeseries",
   "title": "TTFT p95",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 12,
    "y": 0,
    "w": 12,
    "h": 8
   },
   "fieldConfig": {
    "defaults": {
     "unit": "s"
    },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "expr": "histogram_quantile(0.95, sum by (le, model) (rate(llm_ttft_seconds_bucket[5m])))",
     "legendFormat": "{{model}}"
    }
   ]
  },
  {
   "id": 3,
   "type": "timeseries",
   "title": "Round-trip p95",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 0,
    "y": 8,
    "w": 12,
    "h": 8
   },
   "fieldConfig": {
    "defaults": {
     "unit": "s"
    },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "expr": "histogram_quantile(0.95, sum by (le, model) (rate(llm_request_seconds_bucket[5m])))",
     "legendFormat": "{{model}}"
    }
   ]
  },
  {
   "id": 4,
   "type": "timeseries",
   "title": "Prompt bị chặn vì PII",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 12,
    "y": 8,
    "w": 12,
    "h": 8
   },
   "fieldConfig": {
    "defaults": {
     "unit": "short"
    },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum by (pii_type) (increase(llm_pii_blocked_total[1h]))",
     "legendFormat": "{{pii_type}}"
    }
   ]
  },
  {
   "id": 5,
   "type": "timeseries",
   "title": "Agent gọi qua agentgateway (A2A)",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 0,
    "y": 16,
    "w": 12,
    "h": 8
   },
   "fieldConfig": {
    "defaults": {
     "unit": "reqps"
    },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum by (route) (rate(agentgateway_requests_total{route=~\".*a2a-.*\"}[2m]))",
     "legendFormat": "{{route}}"
    }
   ]
  },
  {
   "id": 6,
   "type": "stat",
   "title": "Tổng số lần gọi agent (A2A · 2xx / lỗi)",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 12,
    "y": 16,
    "w": 12,
    "h": 8
   },
   "fieldConfig": {
    "defaults": {
     "unit": "short"
    },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum by (route, status) (agentgateway_requests_total{route=~\".*a2a-.*\"})",
     "legendFormat": "{{route}} ({{status}})"
    }
   ]
  }
 ]
}
