{
 "uid": "cancel-risk-ml",
 "title": "cancel-risk: drift, calibration, A/B theo revision",
 "schemaVersion": 39,
 "time": {
  "from": "now-6h",
  "to": "now"
 },
 "refresh": "30s",
 "tags": [
  "booking"
 ],
 "panels": [
  {
   "id": 1,
   "type": "timeseries",
   "title": "drift-api: p-value KS lead_days",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 0,
    "y": 0,
    "w": 12,
    "h": 8
   },
   "fieldConfig": {
    "defaults": {
     "unit": "short"
    },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "expr": "drift_p_value{feature=\"lead_days\"}",
     "legendFormat": "model {{model_version}}"
    },
    {
     "refId": "B",
     "expr": "vector(0.05)",
     "legendFormat": "ngưỡng 0,05"
    }
   ]
  },
  {
   "id": 2,
   "type": "timeseries",
   "title": "drift_monitor: PSI / lệch calibration",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 12,
    "y": 0,
    "w": 12,
    "h": 8
   },
   "fieldConfig": {
    "defaults": {
     "unit": "short"
    },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "expr": "cancel_risk_psi",
     "legendFormat": "PSI v{{model_version}}"
    },
    {
     "refId": "B",
     "expr": "cancel_risk_calib_gap",
     "legendFormat": "calib gap v{{model_version}}"
    },
    {
     "refId": "C",
     "expr": "vector(0.2)",
     "legendFormat": "ngưỡng PSI 0,2"
    },
    {
     "refId": "D",
     "expr": "vector(0.03)",
     "legendFormat": "ngưỡng calib 0,03"
    }
   ]
  },
  {
   "id": 3,
   "type": "timeseries",
   "title": "A/B: request / giây theo revision",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 0,
    "y": 8,
    "w": 12,
    "h": 8
   },
   "fieldConfig": {
    "defaults": {
     "unit": "reqps"
    },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum by (revision_name) (rate(revision_app_request_count{namespace_name=\"ml\", configuration_name=\"cancel-risk-predictor\"}[1m]))",
     "legendFormat": "{{revision_name}}"
    }
   ]
  },
  {
   "id": 4,
   "type": "timeseries",
   "title": "A/B: latency p95 theo revision",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 12,
    "y": 8,
    "w": 12,
    "h": 8
   },
   "fieldConfig": {
    "defaults": {
     "unit": "ms"
    },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "expr": "histogram_quantile(0.95, sum by (le, revision_name) (rate(revision_app_request_latencies_bucket{namespace_name=\"ml\", configuration_name=\"cancel-risk-predictor\"}[5m])))",
     "legendFormat": "{{revision_name}}"
    }
   ]
  },
  {
   "id": 5,
   "type": "timeseries",
   "title": "A/B: tỉ lệ lỗi theo revision",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 0,
    "y": 16,
    "w": 12,
    "h": 8
   },
   "fieldConfig": {
    "defaults": {
     "unit": "percentunit"
    },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum by (revision_name) (rate(revision_app_request_count{namespace_name=\"ml\", configuration_name=\"cancel-risk-predictor\", response_code_class=\"5xx\"}[5m])) / sum by (revision_name) (rate(revision_app_request_count{namespace_name=\"ml\", configuration_name=\"cancel-risk-predictor\"}[5m]))",
     "legendFormat": "{{revision_name}}"
    }
   ]
  },
  {
   "id": 6,
   "type": "timeseries",
   "title": "drift-api: CloudEvent / giây",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 12,
    "y": 16,
    "w": 12,
    "h": 8
   },
   "fieldConfig": {
    "defaults": {
     "unit": "ops"
    },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum(rate(drift_events_total[1m]))",
     "legendFormat": "events"
    }
   ]
  }
 ]
}
