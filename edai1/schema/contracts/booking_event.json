{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "booking_event",
  "title": "Event trên topic booking_events (generator/stream_gen.py -> Flink booking_events_window)",
  "description": "Vi phạm -> topic booking_events_dlq kèm reason = tên trường sai (flink_jobs/contract.py).",
  "type": "object",
  "required": ["event_id", "type", "event_time", "booking_id", "idempotency_key", "hotel_id", "price"],
  "properties": {
    "event_id": {"type": "integer"},
    "type": {"enum": ["booking_created", "payment_callback", "booking_cancelled"]},
    "event_time": {"type": "integer", "minimum": 0},
    "booking_id": {"type": "integer", "minimum": 1},
    "idempotency_key": {"type": "integer"},
    "hotel_id": {"type": "integer", "minimum": 1},
    "customer_id": {"type": "integer", "minimum": 1},
    "price": {"type": "number", "exclusiveMinimum": 0},
    "nights": {"type": "integer", "minimum": 1},
    "checkin": {"type": "string", "format": "date"}
  }
}
